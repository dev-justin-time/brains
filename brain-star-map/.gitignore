# Expert-agent database (built by `npm run build-agent-db`)
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Blocks Network credentials (populated by `blocks login --write-env`)
.env
.env.*
!.env.example

# Node dependencies (install with `npm install`)
node_modules/

# Blocks agent runtime logs + watchdog PID files
blocks/logs/
*.log
*.pid
